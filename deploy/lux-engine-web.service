[Unit]
Description=Lux Engine Next.js Web Application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=luxengine
Group=luxengine
WorkingDirectory=/opt/luxengine/lux-engine
Environment=NODE_ENV=production
EnvironmentFile=/etc/luxengine/web.env
ExecStart=/usr/bin/node /opt/luxengine/lux-engine/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
