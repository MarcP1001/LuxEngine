[Unit]
Description=Free Claude Code Proxy Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=luxengine
Group=luxengine
WorkingDirectory=/opt/luxengine
Environment=HOST=127.0.0.1
Environment=PORT=8082
Environment=HOME=/var/lib/luxengine/service-home
EnvironmentFile=/etc/luxengine/proxy.env
ExecStart=/opt/luxengine/.venv/bin/free-claude-code
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
