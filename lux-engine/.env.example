# Next.js runtime/build environment
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated hosts served by the main Lux Engine application.
# Custom customer domains are treated separately by proxy.ts.
LUXENGINE_PLATFORM_HOSTS=luxengine.io,www.luxengine.io
NEXT_PUBLIC_CANONICAL_HOST=luxengine.io

# Convex deployment selection (development only)
CONVEX_DEPLOYMENT=

# Set these in the Convex production deployment dashboard, not only here:
# CLERK_JWT_ISSUER_DOMAIN
# SUPERADMIN_EMAILS
# MASTER_IDX_KEY
# GEMINI_API_KEY
# GEMINI_MODEL (optional; defaults to gemini-3.6-flash)
# RESEND_API_KEY
# RESEND_FROM_EMAIL
# TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN
# TWILIO_PHONE_NUMBER
# LUXENGINE_CANONICAL_HOST
